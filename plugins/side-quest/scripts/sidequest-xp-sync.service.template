[Unit]
Description=side-quest XP cross-machine MQTT sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash __HOME__/.claude/side-quest/xp-sync-daemon.sh
Restart=always
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=XP_MQTT_HOST=__XP_MQTT_HOST__

[Install]
WantedBy=default.target
